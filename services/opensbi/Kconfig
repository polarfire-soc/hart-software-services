config SERVICE_OPENSBI
	def_bool y
	depends on OPENSBI
	help
        This feature enables support for OPENSBI.
                
		If you do not know what to do here, say Y.

config SERVICE_OPENSBI_IPC
	bool "OpenSBI IPC ecall support"
	default y
	depends on OPENSBI && USE_IHC_V2
	help
        This feature enables support for IPC ecall service compatible
		with the Mi-V IHC IP v2.

		If you do not know what to do here, say Y.

config SERVICE_OPENSBI_RPROC_IPC
	bool "Remote Proc ecall service support"
	default yd
	depends on SERVICE_OPENSBI_IPC
	help
        This feature enables support for the IPC RemoteProc ecall service
		compatible with the Mi-V IHC IP v2.
      
		If you do not know what to do here, say Y.

config SERVICE_OPENSBI_IHC
	bool "OpenSBI IHC legacy ecall support"
	default y
	depends on OPENSBI && USE_IHC
	help
        This feature enables support for IHC ecall service
		compatible with the legacy Mi-V IHC subsystem.
                
		If you do not know what to do here, say Y.

config SERVICE_OPENSBI_RPROC
	bool "Remote Proc legacy ecall service support"
	default y
	depends on SERVICE_OPENSBI_IHC
	help
        This feature enables support for RemoteProc ecall service
		compatible with the legacy Mi-V IHC subsystem.
                
		If you do not know what to do here, say Y.

config SERVICE_OPENSBI_CRYPTO
	bool "User Crypto ecall service support"
	default y
	depends on OPENSBI && USE_USER_CRYPTO
	help
	  This feature enables support for user crypto ecall service.

	  If you do not know what to do here, say Y.

config SERVICE_OPENSBI_SUSPEND_CLOCK_SCALING
	bool "Scale MSS clocks during system suspend"
	default n
	depends on SERVICE_OPENSBI
	help
	  This feature lowers CPU, AXI and AHB/APB clocks while Linux is
	  suspended, and retunes MMUART0 around the clock change.

	  If you do not know what to do here, say N.

config SERVICE_OPENSBI_SUSPEND_SCB_CLOCK_SWITCH
	bool "Switch MSS to the SCB clock during system suspend"
	default n
	depends on SERVICE_OPENSBI_SUSPEND_CLOCK_SCALING
	help
	  This feature switches clk_in_mss to the 80 MHz SCB standby clock
	  while Linux is suspended, then disables the MSS PLL Q0 output.

	  If you do not know what to do here, say N.

config SERVICE_OPENSBI_SUSPEND_DDR_POWER_SAVE
	bool "Enable DDR power saving during system suspend"
	default n
	depends on SERVICE_OPENSBI && !SKIP_DDR
	help
	  This feature enables the tested DDR suspend power sequence:
	  disable DRAM clocks through the DDR controller while in
	  self-refresh, put DDR logic in low power, gate DDR PLL outputs,
	  and gate the DDRC sub-block clock until resume.

	  If you do not know what to do here, say N.

config OPENSBI_SRC_DIR
	string
	option env="OPENSBI_SRC_DIR"

